# Copy to .env and adjust. All values are optional.
PORT=3000
# Enable only when the site is served over HTTPS (turns on Secure cookies and HSTS).
# NODE_ENV=production

# Database file (default: data/kccitm.db)
# DB_FILE=/var/lib/kccitm/kccitm.db

# Live online payments via Razorpay. Leave empty to use the built-in sandbox gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Initial admin password used when the database is first created.
ADMIN_PASSWORD=

# Set to false so a fresh database starts without demo data.
SEED_DEMO=false

# Minimum attendance (%) for admit-card eligibility.
MIN_ATTENDANCE=75

# Institute contact details shown on the website, receipts and documents.
INSTITUTE_PHONE=+91-9971731071
INSTITUTE_PHONE_2=+91-9891070497
ADMISSION_EMAIL=admission@kccitm.edu.in
INFO_EMAIL=info@kccitm.edu.in
